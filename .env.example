# Application Environment Settings
APP_NAME="RevenueShield AI"
APP_MODE="mock"  # Options: mock, test, production
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration
DATABASE_URL="sqlite:///./revenueshield.db"

# Mode Flags
USE_RAZORPAY=false
USE_GEMINI=false
USE_EMAIL=false
USE_TWILIO=false

# Third Party API Keys (Optional - only required when mode flags above are set to true)
RAZORPAY_KEY_ID="rzp_test_mockkey12345"
RAZORPAY_KEY_SECRET="mocksecret12345"
RAZORPAY_WEBHOOK_SECRET="mockwebhooksecret12345"

GEMINI_API_KEY=""

# Merchant Settings Defaults
MERCHANT_TIMEZONE="Asia/Kolkata"
HIGH_VALUE_THRESHOLD=15000.0
MAX_RECOVERY_ATTEMPTS=3
MAX_RECOVERY_WINDOW_HOURS=72
